# torpor-server-fig7-baseline.sif: torpor-server with the pinned staging path in
# memory_manager.hpp commented out, as described in upstream's
# evaluation/figure7/Figure7_README.md. Used for Figure 7, Baseline.
# Build from the repository root (see README.md in this directory):
#   apptainer build torpor-server-fig7-baseline.sif reproduction/images/torpor-server-fig7-baseline.def
Bootstrap: docker
From: paulaugsten/torpor:server@sha256:0b6767fc116160b396c70c375a3b97e13494803358485c739917b17613898e8c

%files
    include/server/model_repo.hpp /gpu-swap/include/server/model_repo.hpp
    reproduction/images/patches/fig7-baseline-memory_manager.patch /tmp/fig7-baseline.patch

%post
    patch -p1 -d /gpu-swap < /tmp/fig7-baseline.patch
    rm /tmp/fig7-baseline.patch
    cd /gpu-swap/build
    make server
    cp target/server /server_bin/server
