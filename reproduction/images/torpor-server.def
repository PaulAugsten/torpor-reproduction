# torpor-server.sif: upstream server plus the host_addr fix in model_repo.hpp.
# Used for Table 4 (remoting, Swap-PCIe), Figures 6 to 11 and Figure 7 +Pinned,
# +Pipeline and +Group.
# Build from the repository root (see README.md in this directory):
#   apptainer build torpor-server.sif reproduction/images/torpor-server.def
Bootstrap: docker
From: paulaugsten/torpor:server@sha256:0b6767fc116160b396c70c375a3b97e13494803358485c739917b17613898e8c

%files
    include/server/model_repo.hpp /gpu-swap/include/server/model_repo.hpp

%post
    cd /gpu-swap/build
    make server
    cp target/server /server_bin/server
